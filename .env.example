# LLM（OpenAI 兼容协议；DeepSeek / 通义 DashScope 均可）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_FAST=deepseek-chat
MODEL_STRONG=deepseek-chat

# Agent 安全阀
MAX_STEPS=8
REQUEST_TIMEOUT_S=60

# GitHub（M2 起使用）
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Langfuse（M9 接入）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Postgres（Tickets 落库；本地开发可先用 SQLite）
DATABASE_URL=postgresql+asyncpg://prsentinel:prsentinel@localhost:5432/prsentinel
